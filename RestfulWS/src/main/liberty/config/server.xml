<server description="restful">

    <featureManager>
      <feature>restfulWS-3.1</feature>
      <feature>transportSecurity-1.0</feature>
      <feature>jsonb-3.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" httpPort="-1" httpsPort="9444" host="*"/>

    <ssl id="defaultSSLConfig" keyStoreRef="defaultKeyStore" trustStoreRef="defaultKeyStore" clientAuthentication="true" sslProtocol="TLSv1.2" verifyHostname="false" />
    <keyStore id="defaultKeyStore" password="passw0rd" location="${server.config.dir}/resources/security/key.p12" updateTrigger="polled" />
</server>